# fizzbuzz, in shit

chore label(n) ong
    fr n % 15 == 0 ong
        yeet "fizzbuzz"
    orfr n % 3 == 0 ong
        yeet "fizz"
    orfr n % 5 == 0 ong
        yeet "buzz"
    bet
    yeet yapify(n)
bet

grind i = 1 til 16 ong
    yap(label(i))
bet

# recursion
chore fact(n) ong
    fr n <= 1 ong
        yeet 1
    bet
    yeet n * fact(n - 1)
bet
yap("10! = " + yapify(fact(10)))

# closures: a chore that remembers
chore counter() ong
    stash n = 0
    chore tick() ong
        n += 1
        yeet n
    bet
    yeet tick
bet

stash c = counter()
c()
c()
yap("counted til " + yapify(c()))

# piles and yaps
stash words = ["shit", "is", "a", "language"]
stash line = ""
grind w among words ong
    line += w + " "
bet
yap(line)

words[0] = "this"
yap(words)

# keep going til you bail
stash n = 0
stash evens = []
keep based ong
    n += 1
    fr n % 2 == 1 ong
        skip
    bet
    fr n > 10 ong
        bail
    bet
    evens = stuff(evens, n)
bet
yap(evens)
yap("2 ^ 16 = " + yapify(2 ^ 16))
