{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "aura",
  "scopeName": "source.aura",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#yap"
    },
    {
      "include": "#math"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#builtin"
    },
    {
      "include": "#chore-name"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.aura",
      "match": "#.*$"
    },
    "yap": {
      "name": "string.quoted.double.aura",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aura",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.aura",
          "begin": "(?<!\\{)\\{(?!\\{)",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.aura"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.aura"
            }
          },
          "patterns": [
            {
              "include": "#yap"
            },
            {
              "include": "#math"
            },
            {
              "include": "#builtin"
            },
            {
              "include": "#operator"
            }
          ]
        }
      ]
    },
    "math": {
      "name": "constant.numeric.aura",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.aura",
          "match": "\\b(fr|orfr|whatever|keep|grind|til|by|among|bail|skip|yeet|sus|whoops|oops|ong|bet)\\b"
        },
        {
          "name": "keyword.declaration.aura",
          "match": "\\b(stash|chore)\\b"
        },
        {
          "name": "keyword.operator.logical.aura",
          "match": "\\b(also|orelse|nah)\\b"
        },
        {
          "name": "constant.language.aura",
          "match": "\\b(based|cringe|ghosted)\\b"
        }
      ]
    },
    "builtin": {
      "name": "support.function.builtin.aura",
      "match": "\\b(cook|beg|summon|slurp|spill|dribble|isthere|handed|bounce|howmany|whatis|yapify|mathify|is_math|is_yap|is_pile|is_chore|smol|chonk|total|absolutely|roundish|chunk|flip|where|gotit|stuff|yoink|sortof|glue|shred|shout|whisper|trim|labels|goods|eachof|keepif|smoosh|rummage|isfolder|stitch)\\b(?=\\s*\\()"
    },
    "chore-name": {
      "match": "\\b(chore)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.aura"
        },
        "2": {
          "name": "entity.name.function.aura"
        }
      }
    },
    "operator": {
      "name": "keyword.operator.aura",
      "match": "(\\+=|-=|\\*=|/=|==|!=|<=|>=|[-+*/%^<>=])"
    }
  }
}
