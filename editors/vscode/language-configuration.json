{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["{", "}"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "\\bong\\s*$",
    "decreaseIndentPattern": "^\\s*(bet|whatever|orfr|whoops)\\b"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
