# fizzbuzz, in aura

chore label(n) ong
    fr n % 15 == 0 ong
        yeet "fizzbuzz"
    orfr n % 3 == 0 ong
        yeet "fizz"
    orfr n % 5 == 0 ong
        yeet "buzz"
    bet
    yeet yapify(n)
bet

grind i = 1 til 16 ong
    cook(label(i))
bet

# recursion
chore fact(n) ong
    fr n <= 1 ong
        yeet 1
    bet
    yeet n * fact(n - 1)
bet
cook("10! = {fact(10)}")

# closures: a chore that remembers
chore counter() ong
    stash n = 0
    chore tick() ong
        n += 1
        yeet n
    bet
    yeet tick
bet

stash c = counter()
c()
c()
cook("counted til {c()}")

# piles and yaps
stash words = ["aura", "is", "a", "language"]
stash line = ""
grind w among words ong
    line += w + " "
bet
cook(line)

words[0] = "this"
cook(words)

# keep going til you bail
stash n = 0
stash evens = []
keep based ong
    n += 1
    fr n % 2 == 1 ong
        skip
    bet
    fr n > 10 ong
        bail
    bet
    evens = stuff(evens, n)
bet
cook(evens)
cook("2 ^ 16 = {2 ^ 16}")

# bags
stash tally = {}
grind w among shred("the quick the lazy the end") ong
    fr gotit(tally, w) ong
        tally[w] += 1
    whatever
        tally[w] = 1
    bet
bet
cook(tally)
cook("distinct words: {howmany(tally)}")
cook(sortof(labels(tally)))
cook(glue(["aura", "still", "works"], " "))

# sus business
chore safe_div(a, b) ong
    sus ong
        yeet a / b
    whoops e ong
        cook("dodged: {e["why"]}")
        yeet 0
    bet
bet
cook("10 / 2 = {safe_div(10, 2)}")
cook("10 / 0 = {safe_div(10, 0)}")
