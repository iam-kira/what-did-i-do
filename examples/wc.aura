# A word counter: python aura.py examples/wc.aura FILE-OR-FOLDER...
#
# Folders are walked one level deep. Missing paths are reported, not fatal.

stash targets = handed()

fr howmany(targets) == 0 ong
    cook("give me a file or a folder")
    bounce(2)
bet

chore count(path) ong
    stash text = slurp(path)
    stash lines = howmany(shred(text, "
"))
    cook("{path}: {lines} lines, {howmany(shred(text))} words, {howmany(text)} chars")
bet

grind path among targets ong
    fr nah isthere(path) ong
        cook("{path}: not there")
        skip
    bet

    fr isfolder(path) ong
        grind name among rummage(path) ong
            stash inner = stitch(path, name)
            fr nah isfolder(inner) ong
                sus ong
                    count(inner)
                whoops e ong
                    cook("{inner}: {e.why}")
                bet
            bet
        bet
        skip
    bet

    sus ong
        count(path)
    whoops e ong
        cook("{path}: {e.why}")
    bet
bet
